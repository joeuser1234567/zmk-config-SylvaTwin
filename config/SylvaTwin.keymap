#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define WIN 0
#define MAC 1
#define NUM 2
#define MARK 3
#define BT 4
#define SCRL 5

/ {
    combos {
        compatible = "zmk,combos";

        win_default {
            bindings = <&to WIN>;
            key-positions = <11 1>;
        };

        mac_default {
            bindings = <&to MAC>;
            key-positions = <11 34>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q      &kp W         &kp E         &kp R             &lt SCRL T        &none                                     &mkp MCLK       &kp Y          &kp U  &kp I      &kp O      &kp P
&kp A             &kp S         &kp D         &kp F             &kp G             &none                                     &mkp RCLK       &kp H          &kp J  &kp K      &kp L      &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &lt BT B          &lt MARK LANGUAGE_1     &none  &none      &kp LANGUAGE_2  &kp N          &kp M  &kp COMMA  &kp DOT    &mt RIGHT_SHIFT SINGLE_QUOTE
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &mt LEFT_GUI TAB  &mt LEFT_CONTROL SPACE  &none  &mkp LCLK  &lt NUM ENTER   &kp BACKSPACE  &none  &none      &kp COLON  &lt NUM SLASH
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        mac_default_layer {
            bindings = <
&mt ESCAPE Q      &kp W         &kp E         &kp R             &lt SCRL T  &none                                     &mkp MCLK       &kp Y          &kp U  &kp I      &kp O      &kp P
&kp A             &kp S         &kp D         &kp F             &kp G       &none                                     &mkp RCLK       &kp H          &kp J  &kp K      &kp L      &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &lt BT B    &lt MARK LANGUAGE_1     &none  &none      &kp LANGUAGE_2  &kp N          &kp M  &kp COMMA  &kp DOT    &mt RIGHT_SHIFT SINGLE_QUOTE
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp TAB     &mt LEFT_COMMAND SPACE  &none  &mkp LCLK  &lt NUM ENTER   &kp BACKSPACE  &none  &none      &kp COLON  &lt NUM SLASH
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        number_and_arrows_layer {
            bindings = <
&kp N7        &kp NUMBER_8  &kp N9        &kp PLUS      &kp MINUS  &trans                  &trans  &kp F2          &kp F3          &kp F12          &trans  &trans
&kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH  &trans                  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &trans     &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans        &kp NUMBER_0  &kp PERIOD    &trans        &trans     &trans  &trans  &trans  &trans  &kp DELETE      &trans          &trans           &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mark_layer {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR    &kp PERCENT  &trans                  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp EQUAL         &kp PLUS
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &trans        &trans       &trans                  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON      &trans            &kp UNDERSCORE
&kp GRAVE        &kp TILDE      &kp PIPE      &kp QUESTION  &trans       &trans  &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES
&trans           &trans         &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans                &trans                 &trans         &trans            &kp BACKSLASH
            >;
        };

        bluetooth_layer {
            bindings = <
&trans          &trans  &trans  &trans  &trans  &bt BT_CLR                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans        &trans
&trans          &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans          &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        SCRL_L_R_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_RIGHT SCRL_LEFT>;
        };
    };
};
